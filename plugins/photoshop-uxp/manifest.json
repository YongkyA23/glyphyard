{
  "manifestVersion": 5,
  "id": "com.typeshelf.photoshop",
  "name": "Glyphyard for Photoshop",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "23.3.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "typeshelfPanel",
      "label": { "default": "Glyphyard" },
      "minimumSize": { "width": 220, "height": 160 },
      "preferredDockedSize": { "width": 260, "height": 260 },
      "preferredFloatingSize": { "width": 280, "height": 300 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://127.0.0.1:27716",
        "http://127.0.0.1:27717",
        "http://127.0.0.1:27718",
        "http://127.0.0.1:27719",
        "http://127.0.0.1:27720"
      ]
    }
  }
}
